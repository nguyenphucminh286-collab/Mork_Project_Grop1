# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Local environment / sensitive configs
**/application-local.properties
.env

# Uploads directory (nếu lưu local tạm thời)
uploads/*
